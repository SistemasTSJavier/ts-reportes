# Copiar a frontend/.env (local) y a Vercel Environment Variables.
# Nunca commitear valores reales.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_SITE_URL=https://tacticalsupport.online
VITE_LOGO_BUCKET=ctpat-logs
VITE_EVIDENCE_BUCKET=ctpat-evidence

# Cloudflare Turnstile (site key pública). Secret: TURNSTILE_SECRET_KEY en Edge Function.
# Pruebas locales (siempre pasa): 1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY=
